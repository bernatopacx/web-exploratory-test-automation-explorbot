{
  "name": "web-exploratory-test-automation-explorbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "discover": "tsx src/cli.ts discover",
    "generate": "tsx src/cli.ts generate",
    "analyze:code": "tsx src/cli.ts discover",
    "explore": "tsx src/cli.ts explore",
    "explorbot:mission": "tsx src/cli.ts generate",
    "explorbot:run": "tsx src/cli.ts explore",
    "typecheck": "tsc --noEmit",
    "prepare:test": "npm run generate",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:exploratory": "playwright test tests/generated.spec.ts --grep exploratory",
    "test:monkey": "playwright test tests/generated.spec.ts --grep monkey",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
